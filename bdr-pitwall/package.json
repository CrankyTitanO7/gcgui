{
  "name": "bdr-pitwall",
  "version": "0.2.0",
  "description": "BDR Pitwall - An Electron app for reading car information over serial",
  "author": "Yale Bulldogs Racing <bulldogsracing@elilists.yale.edu>",
  "main": "electron/main.js",
  "scripts": {
  "dev": "concurrently \"vite\" \"electron .\"",
  "build": "vite build",
  "start": "npm run build && electron .",
  "package": "npm run build && electron-builder --publish never",
  "release": "npm run build && electron-builder --publish always",
  "rebuild": "electron-rebuild -f -w serialport"
  },
  "repository": {
  "type": "git",
  "url": "https://github.com/Bulldogs-Racing/pitwall.git"
  }, 
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "build": {
    "appId": "com.yourname.pitwall",
    "productName": "Pitwall",
    "publish": {
      "provider": "github"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": ["dmg", "zip"]
    }
  }
}
