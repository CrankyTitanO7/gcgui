{
    "name": "gcgui",
    "version": "0.2.0",
    "description": "ground control GUI - An Electron app for reading information over serial",
    "author": "Yale Project Liquid | Yale Undergraduate Aerospace Association",
    "main": "electron/main.js",
    "scripts": {
        "dev": "concurrently \"vite\" \"electron .\"",
        "build": "vite build",
        "start": "npm run build && electron .",
        "package": "npm run build && electron-builder --publish never",
        "release": "npm run build && electron-builder --publish always",
        "rebuild": "electron-rebuild -f -w serialport",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CrankyTitanO7/gcgui.git"
    },
    "dependencies": {
        "@serialport/parser-readline": "^13.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4",
        "serialport": "^13.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "electron": "^44.4.3",
        "electron-builder": "^26.15.3",
        "oxlint": "^1.83.0",
        "vite": "^8.3.0",
        "wait-on": "^9.1.0"
    },
    "build": {
        "appId": "com.yourname.pitwall",
        "productName": "Pitwall",
        "publish": {
            "provider": "github"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "directories": {
            "output": "release"
        },
        "linux": {
            "target": "AppImage"
        },
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ]
        }
    }
}
